, 1]\n","roc_auc = roc_auc_score(y_test, y_prob)\n","\n","print(\"--- Logistic Regression Evaluation Metrics ---\")\n","print(f\"Accuracy:  {accuracy:.4f} ({accuracy*100:.2f}%)\")\n","print(f\"Precision: {precision:.4f}\")\n","print(f\"Recall:    {recall:.4f}\")\n","print(f\"F1 Score:  {f1:.4f}\")\n","print(f\"ROC-AUC:   {roc_auc:.4f}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"rmBfa292On_L","executionInfo":{"status":"ok","timestamp":1786693457827,"user_tz":-330,"elapsed":55,"user":{"displayName":"Manish Bhandri","userId":"04433092828126077522"}},"outputId":"7822c4f8-9adf-4110-9a78-b4a357731ff0"},"execution_count":91,"outputs":[{"output_type":"stream","name":"stdout","text":["--- Logistic Regression Evaluation Metrics ---\n","Accuracy:  0.7197 (71.97%)\n","Precision: 0.7575\n","Recall:    0.8601\n","F1 Score:  0.8055\n","ROC-AUC:   0.7505\n"]}]},{"cell_type":"code","source":["\n","#Confusion Matrix\n","from sklearn.metrics import confusion_matrix\n","cm = confusion_matrix(y_test, y_pred)\n","sns.heatmap(cm, annot=True, fmt=\"d\", cmap=\"Purples\")\n","plt.title(\"Confusion Matrix\", fontweight=\"bold\")\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":201},"id":"whJ7tXU9Ov4M","executionInfo":{"status":"ok","timestamp":1786693725504,"user_tz":-330,"elapsed":456,"user":{"displayName":"Manish Bhandri","userId":"04433092828126077522"}},"outputId":"80d22d35-19bb-4414-8bb4-16586825363a"},"execution_count":96,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 2 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["from sklearn.metrics import roc_curve, roc_auc_score\n","\n","# Predicted probabilities for Class 1\n","y_prob = model.predict_proba(X_test)[:, 1]\n","\n","# Calculate False Positive Rate and True Positive Rate\n","fpr, tpr, thresholds = roc_curve(y_test, y_prob)\n","\n","# Calculate ROC-AUC\n","roc_auc = roc_auc_score(y_test, y_prob)\n","\n","# Plot ROC Curve\n","plt.figure(figsize=(7, 5))\n","plt.plot(fpr, tpr, label=f\"ROC-AUC = {roc_auc:.2f}\")\n","plt.plot([0, 1], [0, 1], linestyle=\"--\")\n","\n","plt.xlabel(\"False Positive Rate\")\n","plt.ylabel(\"True Positive Rate\")\n","plt.title(\"ROC Curve\")\n","plt.legend()\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":186},"id":"G8aFA9DlO2y7","executionInfo":{"status":"ok","timestamp":1786693519305,"user_tz":-330,"elapsed":319,"user":{"displayName":"Manish Bhandri","userId":"04433092828126077522"}},"outputId":"ac512965-0d61-46e0-e8d6-2a1d90876f9a"},"execution_count":93,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 700x500 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","source":[],"metadata":{"id":"d-1dDWAEP4Df"}},{"cell_type":"code","source":["coefficients = model.coef_[0]\n","\n","feature_names = X_final.columns\n","\n","coef_df = pd.DataFrame({\n","    \"Feature\": feature_names,\n","    \"Coefficient\": coefficients\n","})\n","\n","coef_df.sort_values(\n","    by=\"Coefficient\",\n","    ascending=False\n",")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":494},"id":"jp3cg2YKO7ZG","executionInfo":{"status":"ok","timestamp":1786693537361,"user_tz":-330,"elapsed":64,"user":{"displayName":"Manish Bhandri","userId":"04433092828126077522"}},"outputId":"26baca10-6383-4409-a709-9f9de18e1f81"},"execution_count":94,"outputs":[{"output_type":"execute_result","data":{"text/plain":["                         Feature  Coefficient\n","12           DiscountOffered_Yes     0.975755\n","2                TimeSpentOnSite     0.707319\n","4              PreviousPurchases     0.700299\n","8                EmailOpened_Yes     0.682538\n","9                  AdClicked_Yes     0.474004\n","11        MembershipType_Premium     0.434798\n","3                    PagesViewed     0.387499\n","1                   AnnualIncome     0.371558\n","6              DeviceType_M