 0, 0.3));\n","      fill: #FFFFFF;\n","    }\n","  </style>\n","\n","    <script>\n","      const buttonEl =\n","        document.querySelector('#df-0934ada9-e81d-422f-9e71-a42e952bbe83 button.colab-df-convert');\n","      buttonEl.style.display =\n","        google.colab.kernel.accessAllowed ? 'block' : 'none';\n","\n","      async function convertToInteractive(key) {\n","        const element = document.querySelector('#df-0934ada9-e81d-422f-9e71-a42e952bbe83');\n","        const dataTable =\n","          await google.colab.kernel.invokeFunction('convertToInteractive',\n","                                                    [key], {});\n","        if (!dataTable) return;\n","\n","        const docLinkHtml = 'Like what you see? Visit the ' +\n","          '<a target=\"_blank\" href=https://colab.research.google.com/notebooks/data_table.ipynb>data table notebook</a>'\n","          + ' to learn more about interactive tables.';\n","        element.innerHTML = '';\n","        dataTable['output_type'] = 'display_data';\n","        await google.colab.output.renderOutput(dataTable, element);\n","        const docLink = document.createElement('div');\n","        docLink.innerHTML = docLinkHtml;\n","        element.appendChild(docLink);\n","      }\n","    </script>\n","  </div>\n","\n","\n","    </div>\n","  </div>\n"],"application/vnd.google.colaboratory.intrinsic+json":{"type":"dataframe","summary":"{\n  \"name\": \")\",\n  \"rows\": 13,\n  \"fields\": [\n    {\n      \"column\": \"Feature\",\n      \"properties\": {\n        \"dtype\": \"string\",\n        \"num_unique_values\": 13,\n        \"samples\": [\n          \"MembershipType_No Membership\",\n          \"DeviceType_Tablet\",\n          \"DiscountOffered_Yes\"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"Coefficient\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0.35722599345027645,\n        \"min\": -0.13570863189077978,\n        \"max\": 0.9757547488716378,\n        \"num_unique_values\": 13,\n        \"samples\": [\n          -0.1221017210129703,\n          0.014113297651876326,\n          0.9757547488716378\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"}},"metadata":{},"execution_count":94}]},{"cell_type":"markdown","source":["##Business Insights\n","Customers who spend more time on the site and view more pages are considerably more likely to purchase — engagement is the strongest signal.\n","Customers with more previous purchases are more likely to purchase again, indicating strong repeat-customer value.\n","Offering a discount is one of the strongest positive drivers of purchase — customers who receive no discount are noticeably less likely to convert.\n","Opening marketing emails and clicking on ads are both positively associated with purchase, showing marketing engagement translates into conversions.\n","Premium membership customers convert more often than Basic or No-Membership customers.\n","Older customers show a slightly lower likelihood of purchase compared to younger customers, though the effect is modest.\n","Device type and gender have only a small influence on purchase likelihood compared to behavioral and marketing features.\n","##Conclusion & Future Scope\n","#Conclusion\n","The synthetic Customer Purchase dataset was analyzed using Exploratory Data Analysis, Data Cleaning, and Data Preprocessing.\n","A Logistic Regression model was trained to predict whether a customer is likely to make a purchase.\n","The model was evaluated using Accuracy, Precision, Recall, F1-score, and ROC-AUC, achieving 74.9% accuracy and a ROC-AUC of 0.80.\n","The analysis showed that factors such as time spent on site, previous purchases, discount offers, and marketing engagement (email/ads) have the strongest relationship with purchase behavior.\n","\n","##Future Scope\n","Improve model performance using hyperparameter tuning.\n","Compare Logistic Regression with other classification algorithms such as Decision Tree, Random Forest, or XGBoost.\n","Handle class imbalance explicitly using SMOTE or class weights.\n","Use additional behavioral data (e.g., cart abandonment, session recency) to improve prediction.\n","Develop a system that scores visitors in real time and triggers targeted offers for high-probability purchasers.\n","Use the predictions to design more effective, personalized marketing campaigns."],"metadata":{"id":"W9OOrpq7P51Z"}}]}