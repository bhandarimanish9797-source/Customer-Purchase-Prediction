\n","        fill: #D2E3FC;\n","      }\n","\n","      [theme=dark] .colab-df-generate:hover {\n","        background-color: #434B5C;\n","        box-shadow: 0px 1px 3px 1px rgba(0, 0, 0, 0.15);\n","        filter: drop-shadow(0px 1px 2px rgba(0, 0, 0, 0.3));\n","        fill: #FFFFFF;\n","      }\n","    </style>\n","    <button class=\"colab-df-generate\" onclick=\"generateWithVariable('coef_df')\"\n","            title=\"Generate code using this dataframe.\"\n","            style=\"display:none;\">\n","\n","  <svg xmlns=\"http://www.w3.org/2000/svg\" height=\"24px\"viewBox=\"0 0 24 24\"\n","       width=\"24px\">\n","    <path d=\"M7,19H8.4L18.45,9,17,7.55,7,17.6ZM5,21V16.75L18.45,3.32a2,2,0,0,1,2.83,0l1.4,1.43a1.91,1.91,0,0,1,.58,1.4,1.91,1.91,0,0,1-.58,1.4L9.25,21ZM18.45,9,17,7.55Zm-12,3A5.31,5.31,0,0,0,4.9,8.1,5.31,5.31,0,0,0,1,6.5,5.31,5.31,0,0,0,4.9,4.9,5.31,5.31,0,0,0,6.5,1,5.31,5.31,0,0,0,8.1,4.9,5.31,5.31,0,0,0,12,6.5,5.46,5.46,0,0,0,6.5,12Z\"/>\n","  </svg>\n","    </button>\n","    <script>\n","      (() => {\n","      const buttonEl =\n","        document.querySelector('#id_3dc7ec23-69ca-4776-b21a-a8cc1067ef0a button.colab-df-generate');\n","      buttonEl.style.display =\n","        google.colab.kernel.accessAllowed ? 'block' : 'none';\n","\n","      buttonEl.onclick = () => {\n","        google.colab.notebook.generateWithVariable('coef_df');\n","      }\n","      })();\n","    </script>\n","  </div>\n","\n","    </div>\n","  </div>\n"],"application/vnd.google.colaboratory.intrinsic+json":{"type":"dataframe","variable_name":"coef_df","summary":"{\n  \"name\": \"coef_df\",\n  \"rows\": 19,\n  \"fields\": [\n    {\n      \"column\": \"Feature\",\n      \"properties\": {\n        \"dtype\": \"string\",\n        \"num_unique_values\": 19,\n        \"samples\": [\n          \"num__TimeSpentOnSite\",\n          \"num__PagesViewed\",\n          \"cat__DeviceType_Tablet\"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"Coefficient\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0.3084183114462832,\n        \"min\": -0.31193163183031497,\n        \"max\": 0.708020041304925,\n        \"num_unique_values\": 19,\n        \"samples\": [\n          0.708020041304925,\n          0.42011352932906243,\n          0.1497553757189398\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"}},"metadata":{},"execution_count":207}]},{"cell_type":"code","source":["import joblib\n","\n","joblib.dump(model, \"customer_purchase_model.pkl\")\n","\n","print(\"Model file created successfully!\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"pP5rk8UZZuZ2","executionInfo":{"status":"ok","timestamp":1787139950041,"user_tz":-330,"elapsed":29,"user":{"displayName":"Manish Bhandri","userId":"04433092828126077522"}},"outputId":"c797227c-a204-42f2-ddbe-61b42173fc2b"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Model file created successfully!\n"]}]},{"cell_type":"markdown","source":["##Business Insights\n","Customers who spend more time on the site and view more pages are considerably more likely to purchase — engagement is the strongest signal.\n","Customers with more previous purchases are more likely to purchase again, indicating strong repeat-customer value.\n","Offering a discount is one of the strongest positive drivers of purchase — customers who receive no discount are noticeably less likely to convert.\n","Opening marketing emails and clicking on ads are both positively associated with purchase, showing marketing engagement translates into conversions.\n","Premium membership customers convert more often than Basic or No-Membership customers.\n","Older customers show a slightly lower likelihood of purchase compared to younger customers, though the effect is modest.\n","Device type and gender have only a small influence on purchase likelihood compared to behavioral and marketing features.\n","##Conclusion & Future Scope\n","#Conclusion\n","The synthetic Customer Purchase dataset was analyzed using Exploratory Data Analysis, Data Cleaning, and Data Preprocessing.\n","A Logistic Regression model was trained to predict whether a customer is likely to make a purchase.\n","The model was evaluated using Accuracy, Precision, Recall, F1-score, and ROC-AUC, achieving 74.9% accuracy and a ROC-AUC of 0.80.\n","The analysis showed that factors such as time spent on site, previous purchases, discount offers, and marketing engagement (email/ads) have the strongest relationship with purchase behavior.\n","\n","##Future Scope\n","Improve model performance using hyperparameter tuning.\n","Compare Logistic Regression with other classification algorithms such as Decision Tree, Random Forest, or XGBoost.\n","Handle class imbalance explicitly using SMOTE or class weights.\n","Use additional behavioral data (e.g., cart abandonment, session recency) to improve prediction.\n","Develop a system that scores visitors in real time and triggers targeted offers for high-probability purchasers.\n","Use the predictions to design more effective, personalized marketing campaigns."],"metadata":{"id":"W9OOrpq7P51Z"}}]}